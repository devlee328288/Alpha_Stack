{
  "name": "ohlcv_stock",
  "title": "종목 시세 (OHLCV)",
  "description": "개별 종목의 일별 시세. 컬럼 구성은 krx_cache.db 의 daily_price 표를 따른다. 필수는 날짜·종목코드·종가 셋뿐이고 나머지는 있으면 검사한다 — 손수 모은 자료에 시가총액까지 갖춰져 있기를 기대하지 않는다.",
  "fields": [
    {
      "name": "bas_dd",
      "type": "date",
      "format": "%Y%m%d",
      "title": "기준일자",
      "description": "거래가 일어난 날. 저장은 YYYYMMDD 여덟 자리로 통일한다.",
      "constraints": { "required": true }
    },
    {
      "name": "code",
      "type": "string",
      "title": "종목코드",
      "description": "여섯 자리 숫자. 엑셀이 앞자리 0 을 지워 5자리로 만드는 일이 잦아 zfill6 으로 되살린다.",
      "constraints": { "required": true, "pattern": "^[0-9]{6}$" }
    },
    {
      "name": "name",
      "type": "string",
      "title": "종목명",
      "description": "같은 코드에 이름이 여럿이면 사명 변경일 수 있어 경고만 하고 값은 살린다."
    },
    {
      "name": "market",
      "type": "string",
      "title": "시장구분",
      "constraints": { "enum": ["KOSPI", "KOSDAQ", "KONEX"] }
    },
    {
      "name": "sector",
      "type": "string",
      "title": "소속부"
    },
    {
      "name": "open",
      "type": "integer",
      "title": "시가",
      "description": "원 단위 정수. 국내 주식은 호가 단위가 1원이라 소수점이 나오면 수정주가일 가능성이 높다.",
      "constraints": { "minimum": 0 }
    },
    {
      "name": "high",
      "type": "integer",
      "title": "고가",
      "constraints": { "minimum": 0 }
    },
    {
      "name": "low",
      "type": "integer",
      "title": "저가",
      "constraints": { "minimum": 0 }
    },
    {
      "name": "close",
      "type": "integer",
      "title": "종가",
      "constraints": { "required": true, "minimum": 0 }
    },
    {
      "name": "change",
      "type": "integer",
      "title": "전일대비"
    },
    {
      "name": "change_rate",
      "type": "number",
      "title": "등락률",
      "description": "퍼센트 값. 0.03 이 아니라 3.0 으로 적는다.",
      "constraints": { "minimum": -100.0, "maximum": 1000.0 }
    },
    {
      "name": "volume",
      "type": "integer",
      "title": "거래량",
      "constraints": { "minimum": 0 }
    },
    {
      "name": "value",
      "type": "integer",
      "title": "거래대금",
      "constraints": { "minimum": 0 }
    },
    {
      "name": "market_cap",
      "type": "integer",
      "title": "시가총액",
      "constraints": { "minimum": 0 }
    },
    {
      "name": "listed_shares",
      "type": "integer",
      "title": "상장주식수",
      "constraints": { "minimum": 0 }
    }
  ],
  "primaryKey": ["bas_dd", "code"],
  "missingValues": ["", "-", "NA", "N/A", "N.A.", "None", "null", "nan", "NaN", "#N/A"],

  "x-alphastack": {
    "version": "1.0",
    "target": {
      "compareWith": "daily_price",
      "description": "합격분은 daily_price 와 같은 열쇠(날짜+종목코드)를 가지므로 대조해 차이를 볼 수 있다. 대조는 반입 단계가 아니라 적재 뒤에 따로 한다."
    },
    "aliases": {
      "bas_dd": ["날짜", "일자", "기준일", "기준일자", "거래일", "date", "Date", "DATE", "trade_date", "TRD_DD", "BAS_DD"],
      "code": ["종목코드", "단축코드", "코드", "종목번호", "ticker", "symbol", "stock_code", "ISU_SRT_CD", "ISU_CD"],
      "name": ["종목명", "회사명", "이름", "stock_name", "ISU_ABBRV", "ISU_NM"],
      "market": ["시장", "시장구분", "소속시장", "market_name", "MKT_NM", "MKT_ID"],
      "sector": ["소속부", "업종", "섹터", "industry", "SECT_TP_NM"],
      "open": ["시가", "open_price", "Open", "OPEN", "TDD_OPNPRC"],
      "high": ["고가", "high_price", "High", "HIGH", "TDD_HGPRC"],
      "low": ["저가", "low_price", "Low", "LOW", "TDD_LWPRC"],
      "close": ["종가", "현재가", "수정종가", "close_price", "Close", "CLOSE", "TDD_CLSPRC"],
      "change": ["전일대비", "대비", "diff", "CMPPREVDD_PRC"],
      "change_rate": ["등락률", "등락율", "change_pct", "pct_change", "FLUC_RT"],
      "volume": ["거래량", "vol", "Volume", "VOLUME", "ACC_TRDVOL"],
      "value": ["거래대금", "거래금액", "amount", "ACC_TRDVAL"],
      "market_cap": ["시가총액", "시총", "market_capitalization", "MKTCAP"],
      "listed_shares": ["상장주식수", "주식수", "shares_outstanding", "LIST_SHRS"]
    },
    "cleaners": {
      "bas_dd": ["strip", "to_yyyymmdd"],
      "code": ["strip", "drop_suffix_ks_kq", "zfill6"],
      "name": ["strip"],
      "market": ["strip", "upper", "map_market"],
      "sector": ["strip"],
      "open": ["strip", "strip_comma", "to_int"],
      "high": ["strip", "strip_comma", "to_int"],
      "low": ["strip", "strip_comma", "to_int"],
      "close": ["strip", "strip_comma", "to_int"],
      "change": ["strip", "strip_comma", "to_int"],
      "change_rate": ["strip", "strip_comma", "strip_percent", "to_float"],
      "volume": ["strip", "strip_comma", "to_int"],
      "value": ["strip", "strip_comma", "to_int"],
      "market_cap": ["strip", "strip_comma", "to_int"],
      "listed_shares": ["strip", "strip_comma", "to_int"]
    },
    "rowRules": [
      {
        "id": "high_ge_low",
        "expr": "high >= low",
        "severity": "error",
        "note": "고가가 저가보다 낮으면 두 칸이 뒤바뀐 것이다. 값만 보고는 어느 쪽이 옳은지 알 수 없어 고치지 않고 격리한다."
      },
      {
        "id": "high_ge_open_close",
        "expr": "high >= open and high >= close",
        "severity": "error",
        "note": "고가는 그날 가장 비쌌던 값이므로 시가·종가보다 작을 수 없다."
      },
      {
        "id": "low_le_open_close",
        "expr": "low <= open and low <= close",
        "severity": "error",
        "note": "저가는 그날 가장 쌌던 값이므로 시가·종가보다 클 수 없다."
      },
      {
        "id": "zero_ohlc",
        "expr": "not (open == 0 and high == 0 and low == 0)",
        "severity": "warn",
        "note": "시고저가 셋이 모두 0 인 행은 우리 자료에도 283,468행 있다 — 거래정지 종목을 KRX 가 0 으로 내려준다. 버리지 않고 표시만 한다."
      },
      {
        "id": "zero_ohlc_but_traded",
        "expr": "not (open == 0 and high == 0 and low == 0 and volume > 0)",
        "severity": "warn",
        "note": "가격이 0 인데 거래량이 있는 행. 우리 자료에 125건 있고 정지 중 시간외 체결로 설명된다. 드물어서 눈에 띄게 표시한다."
      },
      {
        "id": "not_future",
        "expr": "bas_dd <= today",
        "severity": "error",
        "note": "오늘보다 뒤인 날짜는 미래 자료이거나 날짜 파싱이 틀린 것이다. 어느 쪽이든 학습에 넣으면 안 된다."
      },
      {
        "id": "is_business_day",
        "expr": "bas_dd is weekday",
        "severity": "warn",
        "note": "토·일에 찍힌 시세. 공휴일까지 판정하려면 거래일 달력이 필요한데 반입 단계에서는 주말만 본다."
      }
    ],
    "lookahead": null
  }
}
