# AlphaStack 환경변수 견본 — 이 파일을 .env 로 복사해 값을 채운다.
#
# ⚠️ .env 는 .gitignore 가 막는다. 절대 커밋하지 않는다 — 이 저장소는 PUBLIC 이다.
# 읽는 순서는 환경변수 → .env → .key 다 (common/secrets.py).
#
# 🔑 키 발급이 막히면 팀장에게 요청한다. KRX 하나만 있으면 1차 필수범위는 전부 돌아간다.

# ── 저장소 선택 ─────────────────────────────────────────────
# postgres | sqlite — 시세를 어디서 읽을지.
# ⚠️ 킥오프 안건이다. 팀 Supabase 를 파기 전까지는 sqlite 로 둔다.
STORE_BACKEND=sqlite

# ── 팀 Supabase (아직 미정 · 킥오프에서 정한다) ──────────────
# 개인 프로젝트 DB 를 그대로 쓰지 않는다. 팀 전용 프로젝트를 새로 판다.
DATABASE_URL=

# ── 필수 ────────────────────────────────────────────────────
# KRX OpenAPI — 시세 수집. 이것 없이는 학습 데이터가 없다. https://openapi.krx.co.kr
KRX_API_KEY=
# KRX 웹 로그인 — OpenAPI 로 안 나오는 화면을 긁을 때만 쓴다
KRX_ID=
KRX_PW=

# ── 선택 범위(⑦ 감성 피처·거시 피처)에서만 필요 ──────────────
DART_API_KEY=                    # 공시 https://opendart.fss.or.kr
ECOS_API_KEY=                    # 한국은행 https://ecos.bok.or.kr
FRED_API_KEY=                    # 미 연준 https://fred.stlouisfed.org
KOSIS_API_KEY=                   # 국가통계포털 https://kosis.kr
FINANCE_SUPERVISORY_API_KEY=     # 금융감독원
HUGGINGFACE_ACCESS_TOKEN=        # ⑦ 무료 인코더. 생성형 API 가 아니다 (절대 제약 준수)
