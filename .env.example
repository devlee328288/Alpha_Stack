# AlphaStack 환경변수 견본 — 이 파일을 .env 로 복사해 값을 채운다.
#
# ⚠️ .env 는 .gitignore 가 막는다. 절대 커밋하지 않는다 — 이 저장소는 PUBLIC 이다.
# 읽는 순서는 환경변수 → .env → .key 다 (common/secrets.py).
#
# 🔑 키 발급이 막히면 팀장에게 요청한다. KRX 하나만 있으면 1차 필수범위는 전부 돌아간다.

# ── 저장소 선택 ─────────────────────────────────────────────
# postgres | sqlite — 시세를 어디서 읽을지.
#
# ✅ **2026-08-26 확정: 1차는 sqlite 하나다.** 회의안건 A-1 이 (b)
#    *"parquet 스냅샷 + 로컬 SQLite"* 로 닫혔다 — **Supabase 는 쓰지 않는다.**
#    워터마크(D-02)·호출 예산(D-04)·원본 보존(D-01)이 전부 `data/krx_cache.db` 안에 있다.
#    `postgres` 로 두면 `asyncpg` 가 의존성에 없어 실행되지 않는다.
STORE_BACKEND=sqlite

# ── Postgres (1차 범위 밖 · 2차 확장용) ──────────────────────
# 비워 둔다. 2차에서 되살릴 때 asyncpg 를 의존성에 넣고 STORE_BACKEND=postgres 로 바꾼다.
DATABASE_URL=

# ── 필수 ────────────────────────────────────────────────────
# KRX OpenAPI — 시세 수집. 이것 없이는 학습 데이터가 없다. https://openapi.krx.co.kr
KRX_API_KEY=
# KRX 웹 로그인 — OpenAPI 로 안 나오는 화면을 긁을 때만 쓴다
KRX_ID=
KRX_PW=

# ── 선택 범위(⑦ 감성 피처·거시 피처)에서만 필요 ──────────────
DART_API_KEY=                    # 공시 https://opendart.fss.or.kr
ECOS_API_KEY=                    # 한국은행 https://ecos.bok.or.kr
FRED_API_KEY=                    # 미 연준 https://fred.stlouisfed.org
KOSIS_API_KEY=                   # 국가통계포털 https://kosis.kr
FINANCE_SUPERVISORY_API_KEY=     # 금융감독원
HUGGINGFACE_ACCESS_TOKEN=        # ⑦ 무료 인코더. 생성형 API 가 아니다 (절대 제약 준수)

# ── 뉴스·카페글 수집 (D-20 · D-21) ──────────────────────────
#
# 🚨 **신규 발급이 막혀 있다.** 네이버 개발자센터 약관 부칙 제2조 ①:
#    *"2026년 7월 30일 24:00를 기점으로 (…) Search API (…) 신규 이용 신청 접수를 중단합니다."*
#    오늘 developers.naver.com 에서 검색 API 키를 새로 받을 수 없다.
#
#    · **7/30 이전에 발급받은 키가 있다면** 그대로 쓴다. 단 **2027-06-30 24:00** 이
#      하드 데드라인이다(부칙 제2조 ②·④). 그 뒤로는 NAVER API HUB 만 남는다.
#    · **키가 없다면** NAVER Cloud Platform 의 **API HUB** 로 가야 한다.
#      인증 헤더가 `X-NCP-APIGW-API-KEY-ID` / `X-NCP-APIGW-API-KEY` 로 바뀌고
#      경로도 `/v1/search/news.json` → `/search/v1/news` 로 바뀐다.
#      한도도 일 25,000 이 아니라 **월 775,000건(월 단위 관리)** 이다.
#
#    ⚠️ 한도는 **클라이언트 아이디(앱)별로 합산**된다 — 계정별이 아니다.
#       뉴스와 카페글이 같은 25,000 을 나눠 쓴다.
#    ⚠️ 약관 7.3 ⑤ 가 **쿼터를 늘릴 목적의 다중 키 발급을 금지**한다.
#       "팀원마다 키를 받아 분산" 은 약관 위반이므로 설계에서 배제한다.
NAVER_API_CLIENT_ID=
NAVER_API_SECRET_KEY=

# ── 동영상 수집 (D-23) ──────────────────────────────────────
# YouTube Data API v3 — Google Cloud Console 에서 프로젝트를 만들고
# "YouTube Data API v3" 를 사용 설정한 뒤 API 키를 발급받는다.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
#
# ⚠️ `search.list` 는 **쓰지 않는다.** 자체 버킷 하루 100콜이라 채널을 훑기에 부족하고,
#    채널 고정 + playlistItems 경로가 훨씬 싸다 (D-23 수용 기준에 grep 검사가 있다).
YOUTUBE_API_KEY=
